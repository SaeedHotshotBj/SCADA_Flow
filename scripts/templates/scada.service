[Unit]
Description=SCADA Flow (Flask + Socket.IO)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/scada
Environment=PYTHONUNBUFFERED=1
Environment=SCADA_HOST=127.0.0.1
Environment=SCADA_PORT=5000
ExecStart=/var/www/scada/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
